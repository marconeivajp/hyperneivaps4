diff --git a/mupen64plus-core/src/device/r4300/cached_interp.c b/mupen64plus-core/src/device/r4300/cached_interp.c
index 1ed9088..91504b4 100644
--- a/mupen64plus-core/src/device/r4300/cached_interp.c
+++ b/mupen64plus-core/src/device/r4300/cached_interp.c
@@ -1045,6 +1045,20 @@ void run_cached_interpreter(struct r4300_core* r4300)
         if (g_DebuggerActive) update_debugger((*r4300_pc_struct(r4300))->addr);
 #endif
         r4300_regs(r4300)[0] = 0;
+        {   /* Hyper Neiva: a cada 20 milhoes de instrucoes, onde a CPU esta e se o contador anda */
+            extern retro_log_printf_t log_cb;
+            static unsigned long long hn_ops = 0;
+            static int hn_marcas = 0;
+            if ((++hn_ops <= 300 || (hn_ops % 1000000ULL) == 0) && hn_marcas < 340 && log_cb)
+            {
+                hn_marcas++;
+                log_cb(RETRO_LOG_INFO, "HN laco ops=%llu pc=%08x count=%08x prox_int=%08x ciclos=%d\n",
+                       hn_ops, (unsigned)*r4300_pc(r4300),
+                       (unsigned)r4300_cp0_regs(&r4300->cp0)[CP0_COUNT_REG],
+                       (unsigned)*r4300_cp0_next_interrupt(&r4300->cp0),
+                       *r4300_cp0_cycle_count(&r4300->cp0));
+            }
+        }
         (*r4300_pc_struct(r4300))->ops();
     }
 }
